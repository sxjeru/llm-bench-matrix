# Database
DATABASE_URL=
DATABASE_DRIVER=
DATABASE_CA=
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX_USES=7500

# Admin gate (single password)
ADMIN_PASSWORD=change-me

# Cloudflare Turnstile (防爆破与防脚本 DoS 人机验证，可选)
# 未配置时自动跳过验证（方便本地开发调试）。生产环境强烈建议配置。
# 官方测试 SiteKey(总是通过): 1x00000000000000000000AA / SecretKey: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Artificial Analysis data API (https://artificialanalysis.ai/api-reference)
# 后台「外部数据源」页签需要，未配置时该页签的拉取动作会被禁用。
ARTIFICIAL_ANALYSIS_API_KEY=

# Vercount analytics script URL (optional)
NEXT_PUBLIC_VERCOUNT_SCRIPT_URL=

# Umami analytics (optional)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=